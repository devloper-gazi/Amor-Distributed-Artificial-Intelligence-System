# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/

# Allow the v2 web UI's TypeScript ``lib`` source folder — the
# generic ``lib/`` rule above is meant for Python distutils
# artefacts.
!web_ui/v2/src/lib/
!web_ui/v2/src/lib/**
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Data
data/
# Sentinel ships small bundled corpora (CWE/OWASP) under
# document_processor/sentinel/data/ — those are source, not data.
!document_processor/sentinel/data/
!document_processor/sentinel/data/**
*.pdf
*.docx
*.xlsx

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Playwright
.playwright/

# Docker
docker-compose.override.yml

# Code Intelligence — runtime artifacts (regenerated each run)
document_processor/code_intelligence/traces/
document_processor/code_intelligence/cache/
document_processor/code_intelligence/extensions/__pycache__/

# pytest + coverage + ruff
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/

# v18.1 — sandbox-shared/ is a runtime artifact for the
# code_intelligence sandbox (named volume bind target on Windows
# hosts).  Per-run subdirectories accumulate test_run/ etc.
sandbox-shared/


# Local GGUF model files — large binaries downloaded by operator
# from HuggingFace (microsoft/bitnet-b1.58-2B-4T-gguf,
# LiquidAI/LFM2-2.6B-GGUF, BoscoTheDog/bitnet_b1_58_3B_gguf, ...).
# Don't ship these in git — they're documented in
# compose/llama-swap/config.yaml + tools/pull_models.py manifest
# so operators can re-pull on demand.
models/*/*.gguf
models/lora/*.gguf
models/lora/**/*.peft
models/lora/**/*.bin
