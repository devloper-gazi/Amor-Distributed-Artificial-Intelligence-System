# Service Configuration
SERVICE_NAME=document-processor
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# Platform Configuration (auto-detected by startup scripts)
# Options: linux, windows, darwin (macOS)
# Leave empty for auto-detection
PLATFORM=

# Processing Configuration
MAX_CONCURRENT_SOURCES=1000
BATCH_SIZE=1000
WORKER_COUNT=4

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=documents
KAFKA_GROUP_ID=processors
KAFKA_PARTITIONS=50

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=300
REDIS_PASSWORD=

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=docdb
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpass123
POSTGRES_POOL_SIZE=20

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=documents
MONGO_USER=
MONGO_PASSWORD=

# Translation API Keys (REQUIRED for translation)
GOOGLE_TRANSLATE_API_KEY=your-google-api-key-here
AZURE_TRANSLATOR_KEY=your-azure-key-here
AZURE_TRANSLATOR_REGION=eastus
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Rate Limits (requests per minute)
GOOGLE_TRANSLATE_RPM=1000
AZURE_TRANSLATE_RPM=2000
ANTHROPIC_RPM=50

# Bloom Filter Configuration
BLOOM_FILTER_CAPACITY=1000000
BLOOM_FILTER_ERROR_RATE=0.01

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Monitoring Configuration
PROMETHEUS_PORT=9090
ENABLE_TRACING=true
ENABLE_METRICS=true

# Code Intelligence Mode — multi-agent local code engine (zero external API)
CODE_OLLAMA_BASE_URL=http://ollama:11434
# Force a specific Ollama tag for every agent. Empty = auto-select per role.
CODE_DEFAULT_MODEL=
# Docker-based code execution sandbox. Mount /var/run/docker.sock (handled
# by docker-compose) for the app to spin up ephemeral runner containers.
CODE_SANDBOX_ENABLED=true
CODE_SANDBOX_TIMEOUT=30
CODE_SANDBOX_MEMORY=256m
# Maximum debug→fix→reexecute loop iterations per session.
CODE_MAX_DEBUG_ITERATIONS=3
# Auto-pull the best code model if none is installed yet.
CODE_AUTO_PULL_MODELS=true
# Redis TTL for in-flight code intelligence sessions (seconds).
CODE_SESSION_TTL_SECONDS=7200
# Comma-separated runner images to pre-pull at startup.
CODE_SANDBOX_PREWARM_IMAGES=python:3.11-slim,node:20-slim

# v2 — Autonomous capability discovery (Hugging Face / GitHub / arXiv)
# The discoverer is failure-quiet: missing SDKs degrade to skipping that
# source. Every candidate passes a six-gate pipeline (license → metadata
# → sandbox install → smoke → benchmark → registration) before being
# added to the registry. Set CODE_CAPABILITY_STRICT=true to require the
# sandboxed install + smoke test (default false defers those gates).
CODE_CAPABILITY_DISCOVERY_ENABLED=true
CODE_CAPABILITY_DISCOVERY_INTERVAL_SECONDS=3600
CODE_CAPABILITY_DISCOVERY_MAX_PER_CYCLE=3

# v2 — Observability. When all three are set, spans go to Langfuse;
# otherwise they fall through to local JSONL traces under
# document_processor/code_intelligence/traces/.
CODE_LANGFUSE_URL=
CODE_LANGFUSE_PUBLIC_KEY=
CODE_LANGFUSE_SECRET_KEY=

# More settings → AI Model picker
# ──────────────────────────────────────────────────────────────────────
# CUSTOM_MODELS_DIR is the path inside both the app *and* ollama
# containers where user-uploaded GGUF weights live. Set by docker-compose
# to /data/custom_models on the shared `custom-models-data` volume —
# leave it as that unless you've also wired your own volume.
CUSTOM_MODELS_DIR=/data/custom_models
# Maximum size (in GB) of a single GGUF upload. Hard-capped server-side
# so a misbehaving client can't fill the host disk. 50 GB is enough for
# even the larger fine-tunes (Llama-70B Q5_K_M ≈ 49 GB).
MAX_MODEL_UPLOAD_SIZE_GB=50

# ──────────────────────────────────────────────────────────────────────
# COGNITIVE UPGRADE — Phase 1A
# ──────────────────────────────────────────────────────────────────────
# Neuro-symbolic verification (Z3) + episodic memory + RLEF rewards.
# Every flag is fail-soft — disabling a feature falls back to the
# previous behaviour without breaking anything.

# Logic Engine — pseudocode/AST + invariants generator.
#   rule_based : pattern-match against the algorithm template catalogue
#                (sort / search / count / lookup / classify) — pure
#                stdlib, deterministic, no LLM hop. (default)
#   small_model: scaffolded for a future small-model strategy.
#   funsearch  : scaffolded for a future evolutionary strategy.
LOGIC_ENGINE_STRATEGY=rule_based

# Z3 SMT Verifier — termination / overflow / exhaustive case analysis.
Z3_VERIFICATION_ENABLED=true
Z3_TIMEOUT_SECONDS=30
Z3_MAX_RETRIES=3

# Episodic Memory — semantic search over past verified sessions so
# the engine can reuse a skeleton (≥0.85 cosine), seed the Logic
# Engine (≥0.60), or fall through to a fresh build (<0.60).
EPISODIC_MEMORY_ENABLED=true
EPISODIC_REUSE_THRESHOLD=0.85
EPISODIC_SEED_THRESHOLD=0.60
EPISODIC_TOP_K=3

# RLEF (Reinforcement Learning from Execution Feedback) — every
# sandbox run emits a composite reward (test pass rate, compilation,
# runtime errors, exec time, Z3 verification, MCTS efficiency).
# Persisted to MongoDB + published to Kafka for the future nightly
# LoRA trainer.
RLEF_ENABLED=true
RLEF_MIN_PASS_RATE=0.8
RLEF_FAST_THRESHOLD_MS=5000
RLEF_KAFKA_TOPIC=task.rlef_reward
RLEF_MONGO_COLLECTION=rlef_rewards
